{
  "name": "bake-me-happy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-product-images.js",
    "dev": "vite",
    "prebuild": "node scripts/prepare-product-images.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "r2:sync": "node scripts/prepare-product-images.js && node scripts/sync-images-to-r2.js",
    "r2:lifecycle": "wrangler r2 bucket lifecycle add bake-me-happy-private-uploads delete-temporary-uploads temp-uploads/ --expire-days 1",
    "prepare:brand-assets": "node scripts/prepare-brand-assets.js",
    "prepare:product-images": "node scripts/prepare-product-images.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "repomix": "^1.18.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wrangler": "^4.119.0"
  }
}
