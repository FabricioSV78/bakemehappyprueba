# PLANTILLA DE VARIABLES PARA CLOUDFLARE PAGES (entorno Production).
# Las variables marcadas como SECRET deben crearse con tipo Secret.

# Sitio y entrega publica de imagenes (tipo Text)
VITE_SITE_URL=https://bakemehappyprueba.pages.dev
# En Cloudflare coloca aqui el dominio real y activo del bucket publico.
# En local debe permanecer vacia para usar las imagenes de respaldo.
VITE_R2_PUBLIC_URL=

# Sincronizacion automatica del catalogo con R2 (tipo Text)
R2_SYNC_ON_BUILD=1
R2_SYNC_BRANCH=main
R2_PUBLIC_BUCKET_NAME=bake-me-happy-assets
CLOUDFLARE_ACCOUNT_ID=

# Autenticacion de la sincronizacion (tipo Secret; nunca guardar el valor en Git)
CLOUDFLARE_API_TOKEN=

# Fotografias privadas de pedidos (Text, Text y Secret respectivamente)
MAX_UPLOAD_BYTES=8388608
UPLOAD_LINK_TTL_SECONDS=86400
UPLOAD_LINK_SECRET=
